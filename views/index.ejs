<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chats</title>
  <link rel="stylesheet" href="/public/index.css">
</head>

<body>
  <h1>Your Chats</h1>
  <% for(let chat of chats){ %>
  <div class="chats">
    <p>From : <%=chat.from%></p>
    <div class="msg">
      <p>Message : <%=chat.msg%></p>
    </div>
    <p>Received : <%=chat.to%></p>
  </div>
  <%}%>
</body>
</html>