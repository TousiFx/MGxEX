<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="style.css">
  <title>Chats</title>

</head>

<body>
  <h1>Your Chats</h1>
  <form method="get" action="/chats/new">
    <button id="new_btn">New</button>
  </form>
  <% for(let chat of chats){ %>
  <div class="chats">
    <p>From : <%=chat.from%></p>
    <div class="msg">
      <p>Message : <%=chat.msg%></p>
    </div>
    <p>Received : <i><%=chat.to%></i></p>
  </div>
  <%}%>
</body>
</html>