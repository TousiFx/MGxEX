<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      /* Reset and base page styles */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        background-color: #f0f2f5;
        color: #1c1e21;
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* Page Heading */
      h2 {
        font-size: 1.8rem;
        color: #075e54;
        margin-bottom: 24px;
        text-align: center;
      }

      /* Form Card Container */
      form {
        background-color: #ffffff;
        width: 100%;
        max-width: 500px;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      /* Text Inputs and Textarea */
      input[type="text"],
      textarea {
        width: 100%;
        font-family: inherit;
        font-size: 1rem;
        color: #111b21;
        background-color: #f8f9fa;
        padding: 12px 16px;
        border: 1px solid #d1d7db;
        border-radius: 8px;
        transition:
          border-color 0.2s ease,
          background-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      /* Message Textarea specific styling */
      textarea {
        min-height: 120px;
        resize: vertical;
        line-height: 1.5;
        background-color: #dcf8c6; /* Subtle nod to your message bubble */
        border-left: 4px solid #25d366;
      }

      /* Focus states for inputs and textarea */
      input[type="text"]:focus,
      textarea:focus {
        outline: none;
        background-color: #ffffff;
        border-color: #075e54;
        box-shadow: 0 0 0 3px rgba(7, 94, 84, 0.12);
      }

      /* Placeholder text color */
      input::placeholder,
      textarea::placeholder {
        color: #777777;
      }

      /* Send Button */
      #send_btn {
        background-color: #075e54;
        color: #ffffff;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 600;
        padding: 12px 20px;
        border: none;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(7, 94, 84, 0.2);
        cursor: pointer;
        margin-top: 4px;
        transition:
          background-color 0.2s ease,
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      #send_btn:hover {
        background-color: #128c7e;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(7, 94, 84, 0.25);
      }

      #send_btn:active {
        transform: translateY(0);
      }

      #send_btn:focus-visible {
        outline: 2px solid #25d366;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <h2>Write New MSG</h2>
    <form method="POST" action="/chats">
      <input type="text" placeholder="who are you" name="from" />
      <textarea name="msg"></textarea>
      <input type="text" placeholder="Add receiver" name="to" />
      <button id="send_btn">Send</button>
    </form>
  </body>
</html>
